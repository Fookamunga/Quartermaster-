# Discord bot token. The bot must already be a member of the server that
# contains #woolworths-ordering and #order-import, with the
# Message Content, Server Members, and Guild Message Reactions
# privileged intents enabled in the Discord Developer Portal.
DISCORD_BOT_TOKEN=

# Override only if the real channel names differ from the defaults.
# WOOLWORTHS_ORDERING_CHANNEL_NAME=woolworths-ordering
# ORDER_IMPORT_CHANNEL_NAME=order-import

# woolies-mcp's HTTP endpoint (the Tailscale Funnel URL on the NAS, e.g.
# https://<funnel-host>/mcp/<token> -- also the URL used in the auth-failure
# alert text and for `npm run login -- --server <url>`).
WOOLIES_MCP_URL=

# staples-host's HTTP endpoint.
STAPLES_HOST_URL=

# Directory for session IDs, the pending-actions store, and sentry state.
# Point this at the mounted Docker volume path on the NAS.
DATA_DIR=./data

# Tag of the cold-session image built from container/Dockerfile.
CONTAINER_IMAGE=discordbot-agent:latest

# Max ms a single cold container run may take before being killed.
# CONTAINER_TIMEOUT_MS=300000

# Auth-failure sentry: poll interval and repeat-while-down interval, in ms.
# AUTH_CHECK_INTERVAL_MS=1800000
# AUTH_ALERT_REPEAT_MS=86400000

# Never-tracked sentry: poll interval, in ms. Set NEVER_TRACKED_TEST_MODE=true
# to also run one check immediately on startup, for verifying the filter
# without waiting up to 6h for real data -- never changes which items
# qualify, only when the check runs.
# NEVER_TRACKED_CHECK_INTERVAL_MS=21600000
# NEVER_TRACKED_TEST_MODE=false

# Claude Code auth for the cold sessions (exactly one of these). Passed
# through to each container filtered from this same .env file -- nothing
# else in it (including DISCORD_BOT_TOKEN) reaches the container.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=
