# Directory for the JSON data volume (items + purchase events). Point this at
# the mounted Docker volume path on the NAS; defaults to ./data for local dev.
DATA_DIR=./data

# Port the MCP HTTP server listens on. woolies-mcp uses 8480 on the NAS.
PORT=8481

# Comma-separated list of hostnames this server will accept requests for
# (DNS-rebinding protection). Set this to your Tailscale Funnel hostname in
# production, e.g. "staples-host.tailXXXX.ts.net". Leave unset for local dev.
# ALLOWED_HOSTS=

# Secret path segment required on the /mcp/<token> route. ALLOWED_HOSTS above
# is only a Host-header check -- anyone who knows the Funnel hostname can
# already send a matching Host header, so it provides no real access control.
# This token is the actual gate before exposing this over Funnel: generate a
# long random value (e.g. `openssl rand -hex 32`) and use it in the connector
# URL as https://<funnel-host>/mcp/<token>, mirroring woolies-mcp's own
# /mcp/<token> pattern. Unset fails closed -- every /mcp/<token> request is
# rejected with 404 rather than silently exposing the endpoint.
MCP_AUTH_TOKEN=

# Anthropic API key for ingest_receipt's (vision) and ingest_order_text's
# (text) one-shot extraction calls -- each a single Messages API call, not
# an Agent SDK session. Must be a real key from console.anthropic.com
# (sk-ant-api03-...) -- a Claude Code OAuth token (sk-ant-oat01-..., e.g.
# from `claude setup-token`) looks similar but is NOT accepted here
# (confirmed by testing: 401 "API key is invalid").
ANTHROPIC_API_KEY=

# Model for both extraction tools above. Optional.
# EXTRACTION_MODEL=claude-sonnet-5

# woolies-mcp's own MCP endpoint (e.g. https://<funnel-host>/mcp/<token>),
# used only by suggest_alternatives to re-resolve a historical product_name
# to a live product via woolies-mcp's own search_products -- staples-host's
# one narrow, read-only exception to never calling woolies-mcp itself. See
# CLAUDE.md's Ownership boundaries. Unset means suggest_alternatives returns
# an empty candidates list rather than guessing -- never a hard failure for
# the rest of staples-host.
WOOLIES_MCP_URL=

# Discord webhook URL for the weekly restock report (every Sunday 5pm NZ
# time -- see weeklyReportSentry.ts), e.g.
# https://discord.com/api/webhooks/<id>/<token>. Create one via the target
# channel's Integrations > Webhooks settings in Discord. Unset means the
# sentry still runs its weekly check but skips posting, logging a warning
# once at startup -- never a hard failure. This job posts directly from
# staples-host, independent of discordbot-host/the Discord bot session.
DISCORD_WEBHOOK_URL=

# How often the weekly-report sentry checks whether it's currently Sunday
# 5pm NZ time, in ms. Optional, defaults to 15 minutes.
# WEEKLY_REPORT_CHECK_INTERVAL_MS=900000
