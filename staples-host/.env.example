# Directory for the JSON data volume (items + purchase events). Point this at
# the mounted Docker volume path on the NAS; defaults to ./data for local dev.
DATA_DIR=./data

# Port the MCP HTTP server listens on. woolies-mcp uses 8480 on the NAS.
PORT=8481

# Comma-separated list of hostnames this server will accept requests for
# (DNS-rebinding protection). Set this to your Tailscale Funnel hostname in
# production, e.g. "staples-host.tailXXXX.ts.net". Leave unset for local dev.
# ALLOWED_HOSTS=

# Craft Connect link (from Craft: Settings -> Connect/API -> select the
# Staples document, copy the generated link, append /api/v1). Scopes which
# documents are visible; treat it like a secret, never commit it.
CRAFT_CONNECT_URL=

# The document ID of the Staples list within that Connect share. Find it by
# GET-ing `${CRAFT_CONNECT_URL}/documents` (with the token below) and
# matching the title.
CRAFT_STAPLES_DOC_ID=

# Craft personal API token, sent as `Authorization: Bearer <token>`. Also
# from Craft: Settings -> Connect/API. Required alongside CRAFT_CONNECT_URL --
# the link alone is not sufficient. Treat like a secret, never commit it.
# This same token also covers writes (POST/DELETE /blocks) -- confirmed
# during development, no separate write-scoped token was needed.
CRAFT_API_TOKEN=

# Document ID of the separate, bot-owned "Staples Status" doc that
# push_status_to_craft() overwrites wholesale. Must already exist -- create
# it manually in Craft first (this server never creates docs), then find its
# ID the same way as CRAFT_STAPLES_DOC_ID above. Must be a DIFFERENT doc from
# CRAFT_STAPLES_DOC_ID -- sync_from_craft() never reads this one.
CRAFT_STATUS_DOC_ID=

# Anthropic API key for ingest_receipt's (vision) and ingest_order_text's
# (text) one-shot extraction calls -- each a single Messages API call, not
# an Agent SDK session. Must be a real key from console.anthropic.com
# (sk-ant-api03-...) -- a Claude Code OAuth token (sk-ant-oat01-..., e.g.
# from `claude setup-token`) looks similar but is NOT accepted here
# (confirmed by testing: 401 "API key is invalid").
ANTHROPIC_API_KEY=

# Model for both extraction tools above. Optional.
# EXTRACTION_MODEL=claude-sonnet-5
